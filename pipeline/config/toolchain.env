# Tool versions every eval host runs. One file for both sides:
#   pipeline/stages/_common.sh reads it at the start of every step, and
#   mac-k3d compiles it in (src/prepare/toolchain.rs) so `setup` installs and
#   checks the same versions the pipeline asserts. A job or caller env var still wins.
# KEY=value lines only; the file is parsed, never sourced as shell.
# Every value here is also listed in docs/dependencies.md (a test keeps them equal).

# Asserted exactly: setup installs it and the env phase refuses any other version.
HARBOR_VERSION=0.22.0

# Downloaded into ~/.docker/cli-plugins only when the plugin is missing; an
# existing compose/buildx (Docker Desktop, apt docker-compose-v2) is kept.
DOCKER_COMPOSE_VERSION=v2.40.3
DOCKER_BUILDX_VERSION=v0.29.1

# Java major version of the Jenkins controller image (Helm controller.image.tagLabel
# jdk<N>). An agent on an older Java connects, then fails with
# UnsupportedClassVersionError, so workers need at least this major version.
JAVA_MAJOR=21

# Minimum versions on every worker host (macOS ships bash 3.2 and python3 3.9).
# Pipeline scripts use bash 4.4 features; host scripts import tomllib (3.11).
BASH_MIN=4.4
PYTHON_MIN=3.11

# Host minimums checked by setup and by the env phase of every build.
MIN_RAM_GB=8
WORKER_MIN_DISK_GB=40

# Linux image that builds and checks iCode's runtime when the host cannot run
# it: macOS, or a host of another CPU type than the task containers. uv,
# Python 3.13, git and bash, for linux/amd64 and linux/arm64. A Linux host of
# the containers' CPU type never pulls it.
ICODE_LINUX_BUILD_IMAGE=ghcr.io/astral-sh/uv:0.9.30-python3.13-bookworm
