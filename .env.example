# Copy to .env in this checkout (gitignored), then: chmod 600 .env
# Supported local store for paid eval stages (P5/P6).
# Do not export this key in the terminal or paste it into chat.
# Jenkins E7 still uses controller credential deepseek-api-key.
DEEPSEEK_API_KEY=
# Catalog Chat Completions ids (not product names). Confirm with:
#   python3 pipeline/lib/openai_compat.py --check-model "$DEEPSEEK_MODEL"
# or: mac-k3d set --check-models
DEEPSEEK_MODEL=deepseek-v4-pro
# Private ICODE_MODE=git clone (local eval). Empty = public repo.
# Do not put a PAT in ICODE_GIT_URL. Jenkins uses gitcode-pat / github-pat.
GITCODE_TOKEN=
GITHUB_TOKEN=
